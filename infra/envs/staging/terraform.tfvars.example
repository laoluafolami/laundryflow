# Copy to terraform.tfvars (git-ignored) for LOCAL runs. CI passes these as TF_VAR_* instead.
admin_ssh_public_key = "ssh-ed25519 AAAA... you@laptop"
alert_email          = "you@example.com"
acr_name             = "acrlaundryxxxxx"
admin_cidr           = "" # e.g. "203.0.113.7/32" to temporarily open SSH
